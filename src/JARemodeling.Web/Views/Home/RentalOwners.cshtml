@{
    ViewData["MainClass"] = "audiencePage";
}
<div class="topline"><span>J&amp;A REMODELING AND SERVICES LLC</span><span>Charlotte, North Carolina</span></div>
<header class="siteHeader"><a class="brand" href="@Lang.T("/", "/es")"><span class="brandMark">J<span>&amp;</span>A</span><span class="brandWords">REMODELING<br/>+ SERVICES</span></a>
    <nav><a href="#workflow">@Lang.T("How J&A plugs into your workflow", "Cómo J&A se integra a su operación")</a><a href="#resources">@Lang.T("What your team receives", "Qué recibe su equipo")</a></nav>
    <div class="headerActions"><a class="language" href="@Lang.T("/es/propietarios", "/rental-owners")">@Lang.T("Español", "English")</a><a class="headerCta" href="#request">@Lang.T("Start a request", "Comenzar solicitud")</a></div>
</header>
<section class="audienceHero">
    <div><a class="backLink" href="@Lang.T("/", "/es")">← J&amp;A Remodeling</a>
        <p class="eyebrow">@Lang.T("FOR RENTAL OWNERS", "PARA PROPIETARIOS")</p>
        <h1>@Lang.T("A guided path from move-out to show-ready.", "Una ruta guiada de move-out a lista para mostrar.")</h1>
        <p>@Lang.T("J&A helps owners translate an uncertain move-out condition into clear decisions: what is required now, what improves presentation and what can wait.", "J&A convierte una condición incierta en decisiones claras: qué se necesita ahora, qué mejora la presentación y qué puede esperar.")</p><a class="button primary" href="#request">@Lang.T("Start a request", "Comenzar solicitud")<span>↗</span></a></div>
    <aside><span>ONE OPERATING PATH</span>
        <div><b>01</b>@Lang.T("Share the property", "Compartir propiedad")</div>
        <div><b>02</b>@Lang.T("Inspect + prioritize", "Inspeccionar")</div>
        <div><b>03</b>@Lang.T("Choose the plan", "Elegir plan")</div>
        <div><b>04</b>@Lang.T("Complete the work", "Completar trabajo")</div>
        <div><b>05</b>@Lang.T("Review the handoff", "Revisar entrega")</div>
    </aside>
</section>
<section class="section audienceWorkflow" id="workflow">
    <div class="sectionIntro">
        <p class="eyebrow">@Lang.T("How J&A plugs into your workflow", "Cómo J&A se integra a su operación")</p>
        <h2>@Lang.T("A guided path from move-out to show-ready.", "Una ruta guiada de move-out a lista para mostrar.")</h2>
    </div>
    <div class="workflowList">
        <article><span>01</span>
            <h3>@Lang.T("Share the property", "Compartir propiedad")</h3>
            <p>@Lang.T("Address, move-out timing, access and the result you need: lease, sell or improve.", "Dirección, mudanza, acceso y objetivo: rentar, vender o mejorar.")</p>
        </article>
        <article><span>02</span>
            <h3>@Lang.T("Inspect + prioritize", "Inspeccionar")</h3>
            <p>@Lang.T("Safety and required repairs are separated from presentation upgrades and optional work.", "Separamos seguridad y reparaciones de presentación y opciones.")</p>
        </article>
        <article><span>03</span>
            <h3>@Lang.T("Choose the plan", "Elegir plan")</h3>
            <p>@Lang.T("Approve the itemized scope, target date, materials and change-order limit.", "Apruebe alcance, fecha, materiales y límite de cambios.")</p>
        </article>
        <article><span>04</span>
            <h3>@Lang.T("Complete the work", "Completar trabajo")</h3>
            <p>@Lang.T("J&A coordinates the approved trades in the right order.", "Coordinamos los oficios en la secuencia correcta.")</p>
        </article>
        <article><span>05</span>
            <h3>@Lang.T("Review the handoff", "Revisar entrega")</h3>
            <p>@Lang.T("Receive final status, photos and any maintenance recommendations still open.", "Reciba estado, fotos y recomendaciones pendientes.")</p>
        </article>
    </div>
</section>
<section class="section resourceSection" id="resources">
    <div>
        <p class="eyebrow">@Lang.T("What your team receives", "Qué recibe su equipo")</p>
        <h2>@Lang.T("Structure that reduces follow-up.", "Estructura que reduce seguimiento.")</h2>
        <ul>
            <li>@Lang.T("✓ Plain-language scope", "✓ Alcance en lenguaje claro")</li>
            <li>@Lang.T("✓ Required / recommended / optional choices", "✓ Opciones necesarias / recomendadas")</li>
            <li>@Lang.T("✓ One point of contact", "✓ Un contacto")</li>
            <li>@Lang.T("✓ Written approval before extra work", "✓ Aprobación escrita")</li>
            <li>@Lang.T("✓ Final photo documentation", "✓ Fotos finales")</li>
            <li>@Lang.T("✓ Next-maintenance recommendations", "✓ Recomendaciones de mantenimiento")</li>
        </ul>
    </div>
    <div>
        <p class="eyebrow">@Lang.T("What we need from you", "Qué necesitamos de usted")</p>
        <h2>@Lang.T("A complete intake starts here.", "Un ingreso completo comienza aquí.")</h2>
        <ul>
            <li>@Lang.T("→ Property address and type", "→ Dirección y tipo")</li>
            <li>@Lang.T("→ Vacancy / possession date", "→ Fecha vacante")</li>
            <li>@Lang.T("→ Target lease or listing date", "→ Fecha de listing")</li>
            <li>@Lang.T("→ Access instructions after intake", "→ Acceso después del intake")</li>
            <li>@Lang.T("→ Known damage and priorities", "→ Daños y prioridades")</li>
            <li>@Lang.T("→ Budget or approval limit", "→ Presupuesto o límite")</li>
        </ul>
    </div>
</section><partial name="_RelatedAudiences" />
<section class="contactSection" id="request">
    <div class="contactCopy">
        <p class="eyebrow">@Lang.T("FOR RENTAL OWNERS", "PARA PROPIETARIOS")</p>
        <h2>@Lang.T("Ready to organize the property?", "¿Listo para organizar la propiedad?")</h2>
        <p>@Lang.T("J&A helps owners translate an uncertain move-out condition into clear decisions: what is required now, what improves presentation and what can wait.", "J&A convierte una condición incierta en decisiones claras: qué se necesita ahora, qué mejora la presentación y qué puede esperar.")</p><a href="tel:+19802984600">980-298-4600 <span>→</span></a></div><partial name="_LeadForm" model="@(new LeadFormOptions("rental-owner", "rental-owners"))" /></section>
<footer>
    <div class="footerBrand"><span class="brandMark">J<span>&amp;</span>A</span>
        <p>Unit turns · Make-ready · Maintenance · Renovation<br/>3119 Central Ave, Unit I · Charlotte, NC 28205</p>
    </div>
    <div><strong>J&amp;A Remodeling and Services LLC</strong><a href="tel:+19802984600">980-298-4600</a><a href="mailto:abelmancilla863@@gmail.com">abelmancilla863@@gmail.com</a><a href="@Lang.T("/", "/es")">J&amp;A Remodeling</a></div>
</footer>
