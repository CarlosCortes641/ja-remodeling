<section class="section processSection" id="process">
    <div class="sectionIntro">
        <p class="eyebrow">@Lang.T("HOW IT WORKS", "CÓMO FUNCIONA")</p>
        <h2>@Lang.T("A clear operating path from request to rent-ready.", "Una ruta clara desde la solicitud hasta lista para rentar.")</h2>
        <p>@Lang.T("This is more than a diagram. Each stage below explains why the information matters and lets a client begin organizing the actual turn request.", "Esto es más que un diagrama. Cada etapa explica por qué importa la información y permite comenzar a organizar la solicitud real.")</p>
    </div>
    <div class="turnPlanner">
        <p class="plannerIntro">@Lang.T("Open each step to see why it exists, what information J&A needs, what the client receives and what action happens next.", "Abra cada paso para ver por qué existe, qué información necesita J&A, qué recibe el cliente y cuál es la siguiente acción.")</p>
        <form data-turn-planner>
            <details id="step-1" open="">
                <summary><span>01</span><strong>@Lang.T("Submit the property", "Enviar la propiedad")</strong>
                    <small>@Lang.T("Request acknowledgment and the next scoping action.", "Confirmación de la solicitud y próximo paso para definir el alcance.")</small><b>+</b></summary>
                <div class="stepBody">
                    <div class="stepContext">
                        <article><span>@Lang.T("Why we need it", "Por qué lo necesitamos")</span>
                            <p>@Lang.T("A complete intake prevents delays and lets J&A route the request to the right production plan.", "Un ingreso completo evita retrasos y permite asignar la solicitud al plan de producción correcto.")</p>
                        </article>
                        <article><span>@Lang.T("Information required", "Información necesaria")</span>
                            <p>@Lang.T("Property, contact, unit count, vacancy date, target date and initial description.", "Propiedad, contacto, unidades, fecha vacante, fecha objetivo y descripción inicial.")</p>
                        </article>
                        <article><span>@Lang.T("What you receive", "Qué recibe")</span>
                            <p>@Lang.T("Request acknowledgment and the next scoping action.", "Confirmación de la solicitud y próximo paso para definir el alcance.")</p>
                        </article>
