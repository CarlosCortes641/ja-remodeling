@{
    ViewData["MainClass"] = "audiencePage";
}
<div class="topline"><span>J&amp;A REMODELING AND SERVICES LLC</span><span>Charlotte, North Carolina</span></div>
<header class="siteHeader"><a class="brand" href="@Lang.T("/", "/es")"><span class="brandMark">J<span>&amp;</span>A</span><span class="brandWords">REMODELING<br/>+ SERVICES</span></a>
    <nav><a href="#workflow">@Lang.T("How J&A plugs into your workflow", "Cómo J&A se integra a su operación")</a><a href="#resources">@Lang.T("What your team receives", "Qué recibe su equipo")</a></nav>
    <div class="headerActions"><a class="language" href="@Lang.T("/es/administradores", "/property-managers")">@Lang.T("Español", "English")</a><a class="headerCta" href="#request">@Lang.T("Start a request", "Comenzar solicitud")</a></div>
</header>
<section class="audienceHero">
    <div><a class="backLink" href="@Lang.T("/", "/es")">← J&amp;A Remodeling</a>
        <p class="eyebrow">@Lang.T("FOR PROPERTY MANAGERS", "PARA ADMINISTRADORES")</p>
        <h1>@Lang.T("A turn partner that works like an extension of operations.", "Un socio de turns que funciona como extensión de operaciones.")</h1>
        <p>@Lang.T("Send one work order or a portfolio list. J&A converts the request into an inspectable scope, controls approvals and returns a documented close-out your leasing, maintenance and accounting teams can use.", "Envíe una orden o una lista de portafolio. J&A la convierte en alcance verificable, controla aprobaciones y devuelve un cierre útil para leasing, mantenimiento y contabilidad.")</p><a class="button primary" href="#request">@Lang.T("Start a request", "Comenzar solicitud")<span>↗</span></a></div>
    <aside><span>ONE OPERATING PATH</span>
        <div><b>01</b>@Lang.T("Send the queue", "Enviar la cola")</div>
        <div><b>02</b>@Lang.T("Align the standard", "Alinear el estándar")</div>
        <div><b>03</b>@Lang.T("Approve the scope", "Aprobar alcance")</div>
        <div><b>04</b>@Lang.T("Run the turn", "Ejecutar el turn")</div>
        <div><b>05</b>@Lang.T("Return the unit", "Devolver la unidad")</div>
    </aside>
</section>
<section class="section audienceWorkflow" id="workflow">
    <div class="sectionIntro">
        <p class="eyebrow">@Lang.T("How J&A plugs into your workflow", "Cómo J&A se integra a su operación")</p>
        <h2>@Lang.T("A turn partner that works like an extension of operations.", "Un socio de turns que funciona como extensión de operaciones.")</h2>
    </div>
    <div class="workflowList">
        <article><span>01</span>
            <h3>@Lang.T("Send the queue", "Enviar la cola")</h3>
            <p>@Lang.T("Property, unit, priority, access, target date and work-order or PO requirements.", "Propiedad, unidad, prioridad, acceso, fecha y requisitos de work order o PO.")</p>
        </article>
        <article><span>02</span>
            <h3>@Lang.T("Align the standard", "Alinear el estándar")</h3>
            <p>@Lang.T("J&A learns your paint, flooring, fixture, cleaning, photo and rent-ready standards.", "Definimos pintura, pisos, accesorios, limpieza, fotos y estándar rent-ready.")</p>
        </article>
        <article><span>03</span>
            <h3>@Lang.T("Approve the scope", "Aprobar alcance")</h3>
            <p>@Lang.T("Required, recommended and optional work is separated before crews are released.", "Separamos trabajo necesario, recomendado y opcional antes de liberar equipos.")</p>
        </article>
        <article><span>04</span>
            <h3>@Lang.T("Run the turn", "Ejecutar el turn")</h3>
            <p>@Lang.T("Trades are sequenced; exceptions and out-of-scope conditions route to the approved contact.", "Secuenciamos oficios y enviamos excepciones al contacto aprobado.")</p>
        </article>
        <article><span>05</span>
            <h3>@Lang.T("Return the unit", "Devolver la unidad")</h3>
            <p>@Lang.T("QA, final photos, open recommendations and invoice reference are delivered together.", "QA, fotos, recomendaciones y referencia de factura en una entrega.")</p>
        </article>
    </div>
</section>
<section class="section resourceSection" id="resources">
    <div>
        <p class="eyebrow">@Lang.T("What your team receives", "Qué recibe su equipo")</p>
        <h2>@Lang.T("Structure that reduces follow-up.", "Estructura que reduce seguimiento.")</h2>
        <ul>
            <li>@Lang.T("✓ Unit-by-unit scope and priority matrix", "✓ Alcance y prioridad por unidad")</li>
            <li>@Lang.T("✓ Defined approval threshold and escalation contact", "✓ Límite de aprobación y escalamiento")</li>
            <li>@Lang.T("✓ Milestone or exception-based updates", "✓ Actualizaciones por hitos o excepción")</li>
            <li>@Lang.T("✓ Property-specific QA checklist", "✓ Checklist específico")</li>
            <li>@Lang.T("✓ Final photo record and invoice alignment", "✓ Fotos finales y factura alineada")</li>
            <li>@Lang.T("✓ Vendor onboarding documentation on request", "✓ Documentación de proveedor")</li>
        </ul>
    </div>
    <div>
        <p class="eyebrow">@Lang.T("What we need from you", "Qué necesitamos de usted")</p>
        <h2>@Lang.T("A complete intake starts here.", "Un ingreso completo comienza aquí.")</h2>
        <ul>
            <li>@Lang.T("→ Property and unit list", "→ Lista de propiedades y unidades")</li>
            <li>@Lang.T("→ Vacancy and target dates", "→ Fechas vacantes y objetivo")</li>
            <li>@Lang.T("→ Access and work-hour rules", "→ Acceso y horarios")</li>
            <li>@Lang.T("→ Finish standards and approved materials", "→ Acabados y materiales")</li>
            <li>@Lang.T("→ PO, billing and approval contacts", "→ PO, facturación y aprobadores")</li>
            <li>@Lang.T("→ Occupied-area or resident restrictions", "→ Restricciones de residentes")</li>
        </ul>
    </div>
</section><partial name="_RelatedAudiences" />
<section class="contactSection" id="request">
    <div class="contactCopy">
        <p class="eyebrow">@Lang.T("FOR PROPERTY MANAGERS", "PARA ADMINISTRADORES")</p>
        <h2>@Lang.T("Ready to organize the property?", "¿Listo para organizar la propiedad?")</h2>
        <p>@Lang.T("Send one work order or a portfolio list. J&A converts the request into an inspectable scope, controls approvals and returns a documented close-out your leasing, maintenance and accounting teams can use.", "Envíe una orden o una lista de portafolio. J&A la convierte en alcance verificable, controla aprobaciones y devuelve un cierre útil para leasing, mantenimiento y contabilidad.")</p><a href="tel:+19802984600">980-298-4600 <span>→</span></a></div><partial name="_LeadForm" model="@(new LeadFormOptions("property-manager", "property-managers"))" /></section>
